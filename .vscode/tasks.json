{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: Run DBExpl",
            "type": "process",
            "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "args": [
                "${workspaceFolder}\\DBExpl.py"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Python: Run Current File",
            "type": "process",
            "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "args": [
                "${file}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Python: Run Debug Script",
            "type": "process",
            "command": "${workspaceFolder}\\venv\\Scripts\\python.exe",
            "args": [
                "${workspaceFolder}\\debug_scripts\\${input:scriptName}"
            ],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "scriptName",
            "type": "promptString",
            "description": "Enter the debug script name (e.g., testcase.py)"
        }
    ]
}
